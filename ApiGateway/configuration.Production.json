{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/login",
      "UpstreamHttpMethod": ["POST"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/auth/refresh",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/refresh",
      "UpstreamHttpMethod": ["POST"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/auth/logout",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "UpstreamPathTemplate": "/logout",
      "UpstreamHttpMethod": ["POST"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/auth/user",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "UpstreamPathTemplate": "/user",
      "UpstreamHttpMethod": ["GET"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/auth/register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/register",
      "UpstreamHttpMethod": ["POST"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/auth/reset-password",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/reset-password",
      "UpstreamHttpMethod": ["POST"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/exchange",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workflow",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/exchange",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },

      "RouteClaimsRequirement": {
        "roles": ["exchange-currency"]
      },
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/payment/callback",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "liqpay-provider-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/payment/callback",
      "UpstreamHttpMethod": ["POST"],
      "RouteIsCaseSensitive": false
    },
    {
      "DownstreamPathTemplate": "/api/hub/{route}",
      "UpstreamPathTemplate": "/hub/{route}",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        {
          "Host": "signalr-provider-service",
          "Port": 80
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "RouteClaimsRequirement": {
        "roles": ["exchange-currency"]
      },
      "UpstreamHttpMethod": ["OPTIONS", "POST", "GET"]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://api-gateway"
  }
}
